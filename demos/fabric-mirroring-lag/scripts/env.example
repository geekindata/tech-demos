# Copy to scripts/env.local (gitignored) and fill in. Values come from the Fabric REST API, see env.sh.
# Item names (display names in the trial workspace)
FABRIC_WORKSPACE="<workspace-name>"
SQL_DATABASE="<sql-database-name>"
HELPER_LAKEHOUSE="<helper-lakehouse-name>"
SEED_NOTEBOOK="<seed-notebook-name>"
WORKLOAD_NOTEBOOK="<workload-notebook-name>"
# Connection values
SRC_SERVER="<server-name>.database.fabric.microsoft.com,1433"
SRC_DB="<sql-database-name>-<sql-database-id>"
EP_SERVER="<server-name>.datawarehouse.fabric.microsoft.com"
EP_DB="<sql-database-name>"
# Capacity Metrics semantic model id, only for scripts/metrics_dax.py
METRICS_DATASET_ID="<capacity-metrics-semantic-model-id>"
