# Copy to scripts/env.local (gitignored) and fill in. Read by scripts/envcfg.py and scripts/f2.sh.
AGENT_WS_ID="<workspace-id>"
DATA_AGENT_NAME="<data-agent-name>"
AGENT_LAKEHOUSE="<lakehouse-name>"
# Only for scripts/tsql.py run on its own: SQL analytics endpoint host and database
SQL_ENDPOINT="<server-name>.datawarehouse.fabric.microsoft.com"
SQL_DATABASE="<lakehouse-name>"
# Capacities, only for scripts/f2.sh
TRIAL_CAPACITY="<trial-capacity-name>"
F2_NAME="<f2-capacity-name>"
F2_ARM="/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Fabric/capacities/<f2-capacity-name>"
# Capacity Metrics semantic model id, only for scripts/metrics_cu.py
METRICS_MODEL_ID="<capacity-metrics-semantic-model-id>"
