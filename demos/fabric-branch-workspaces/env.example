# Copy to env.local (gitignored) and fill in your own names.
# MAIN_WS: the Git-connected main (dev) workspace. FEATURE_WS: the workspace created by Branch out.
# MIRROR_WS: optional, a workspace whose running notebooks the refresh watcher waits for.
# TRIAL_SKU: the SKU of your Trial capacity, as returned by GET /v1/capacities.
MAIN_WS=<main workspace name>
FEATURE_WS=<feature workspace name>
MIRROR_WS=<optional workspace to wait for>
TRIAL_SKU=<trial capacity sku>
# CU_LEDGER: optional CSV the refresh watcher appends a CU row to.
CU_LEDGER=<path to a cu ledger csv>
# Extra lowercase fragments to blur (capacity, region, account names), comma separated. Spaces and - are matched as _.
BLUR_EXTRA=<capacity name>,<region>,<github account>,<email local part>
